{
  "name": "LP-W2-lead-processing",
  "nodes": [
    {
      "parameters": {
        "content": "### LP-W2: Lead Processing & CRM Sync\nTriggered when a lead is captured. Syncs contact to HubSpot, notifies Slack for Hot leads, sends follow-up email, and appends to Google Sheets.",
        "height": 160,
        "width": 380
      },
      "id": "sticky-w2",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-lead",
      "name": "Lead Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 320],
      "webhookId": "lead-intake"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/v1/leads/qualify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AI_SERVICE_API_KEY || 'lp_secret_key_demo_2026' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || $json) }}"
      },
      "id": "http-qualify",
      "name": "Qualify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 320]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.score }}",
              "value2": "hot"
            }
          ]
        }
      },
      "id": "if-hot-lead",
      "name": "Is Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/v1/leads/={{ $json.id }}/followup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AI_SERVICE_API_KEY || 'lp_secret_key_demo_2026' }}"
            }
          ]
        }
      },
      "id": "http-send-followup",
      "name": "Trigger Personalized Follow-up Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/v1/admin/mock-outbox",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"integration\": \"slack\",\n  \"action\": \"hot_lead_alert\",\n  \"payload\": {\n    \"channel\": \"#sales-leads\",\n    \"text\": \"🔥 HOT LEAD: \" + ($json.name || 'Anonymous') + \" (\" + ($json.email || 'No email') + \") - Budget: \" + ($json.budget_text || 'standard')\n  }\n}"
      },
      "id": "slack-hot-alert",
      "name": "Slack Hot Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 220]
    }
  ],
  "connections": {
    "Lead Intake Webhook": {
      "main": [
        [
          {
            "node": "Qualify Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qualify Lead": {
      "main": [
        [
          {
            "node": "Is Hot Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Hot Lead?": {
      "main": [
        [
          {
            "node": "Trigger Personalized Follow-up Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Slack Hot Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}
